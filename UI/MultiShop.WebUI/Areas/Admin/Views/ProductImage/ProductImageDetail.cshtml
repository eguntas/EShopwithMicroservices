@model UpdateProductImageDto
@{
    ViewData["Title"] = "ProductImageDetail";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Product Images Update Page</h4>
                <br/>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" asp-for="ProductImageID" />
                        <input type="hidden" asp-for="ProductID" />

                        <label>Images 1</label>
                        <input type="text" class="form-control" asp-for="Images1" />
                        <br />
                        <label>Images 2</label>
                        <input type="text" class="form-control" asp-for="Images2" />
                        <br />
                        <label>Images 3</label>
                        <input type="text" class="form-control" asp-for="Images3" />
                        <br />
                        <label>Images 4</label>
                        <input type="text" class="form-control" asp-for="Images4" />
                        <br />

                        <button class="btn btn-primary">Update Product Images</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

